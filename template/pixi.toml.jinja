[workspace]
name = "{{ project_name }}"
description = "{{ description }}"
channels = ["conda-forge"]
platforms = ["osx-arm64", "linux-64"]

[activation.env]
# Jupyter looks in the environment before the user's kernels, so Quarto runs
# a document's Python in this environment's python3 kernel (Quarto takes the
# first Python kernel it finds, and user kernels otherwise come first).
JUPYTER_PREFER_ENV_PATH = "1"
# typst-diff, which qdiff drives, is built from source into .pixi/tools/ by
# the typst-diff task below; this puts it on the paper environment's PATH.
PATH = "$PIXI_PROJECT_ROOT/.pixi/tools/bin:$PATH"
# The pins. Each format variable is the source `quarto add` installs from;
# to take a later release, change the tag here (and ssus-papers' tag below,
# the same release), run `pixi run formats`, and commit the result.
# wordcount has no release tags, so it is pinned to a commit's archive.
SSUS_PAPERS = "ssus-lab/ssus_papers@v0.0.8"
SSUS_SLIDES = "ssus-lab/ssus_slides@v0.2.2"
WORDCOUNT = "https://github.com/christopherkenny/wordcount/archive/57846cbf8fb01cfd9dd00ed1f72a241fb9731a38.zip"

[dependencies]
python = "3.13.*"
# The Quarto every copy of the paper renders with, recorded in pixi.lock.
quarto = "1.11.*"
ipykernel = "*"
nbclient = "*"
nbformat = "*"
pyyaml = "*"
numpy = "*"
pandas = "*"
matplotlib = "*"

[pypi-dependencies]
# src/, installed editable so analysis/ and notebooks/ import it.
{{ package }} = { path = ".", editable = true }
# ssus_papers.tables and ssus_papers.submit, from the formats' release.
ssus-papers = { git = "https://github.com/ssus-lab/ssus_papers", tag = "v0.0.8", subdirectory = "python" }
# Track-changes PDFs between two versions of the paper (needs typst-diff).
qdiff = { git = "https://github.com/knaaptime/qdiff", tag = "v0.3.0" }

# typst-diff has no releases and no conda package, so pixi builds it with
# cargo, in an environment of its own that carries the Rust toolchain and
# is installed on the first `pixi run diff`; the paper environment stays
# without it. Pinned to a commit: the build is skipped, offline, while
# .pixi/tools/ records that commit, and a new pin rebuilds on the next diff.
# Cargo's downloads stay in the project (.pixi/cargo/).
[feature.typst-diff.dependencies]
rust = "*"

[feature.typst-diff.activation.env]
TYPST_DIFF_REV = "f941929c0f080da5edeca9d573faf7ff042316f7"
CARGO_HOME = "$PIXI_PROJECT_ROOT/.pixi/cargo"

[feature.typst-diff.tasks]
typst-diff = { cmd = "grep -qs $TYPST_DIFF_REV $PIXI_PROJECT_ROOT/.pixi/tools/.crates.toml || cargo install --force --locked --git https://github.com/alexanderkoller/typst-diff --rev $TYPST_DIFF_REV typst-diff --root $PIXI_PROJECT_ROOT/.pixi/tools", description = "Build typst-diff, which qdiff drives, into .pixi/tools/" }

[environments]
typst-diff = { features = ["typst-diff"], no-default-feature = true }

{% raw -%}
[tasks]
# Once, in a new project: each starter, with its formats, at the pinned tags.
init-paper = { cmd = "mkdir -p paper && cd paper && quarto use template $SSUS_PAPERS --no-prompt", description = "Copy the paper starter and install the paper formats into paper/" }
init-slides = { cmd = "mkdir -p slides && cd slides && quarto use template $SSUS_SLIDES --no-prompt", description = "Copy the deck starter and install the slide format into slides/" }
init = { depends-on = ["init-paper", "init-slides", "wordcount"], description = "Set up paper/ and slides/ in a new project" }

# Install, or reinstall, every format at its pin; safe to rerun.
formats-paper = { cmd = "quarto add $SSUS_PAPERS --no-prompt", cwd = "paper" }
formats-slides = { cmd = "quarto add $SSUS_SLIDES --no-prompt", cwd = "slides" }
wordcount = { cmd = "quarto add $WORDCOUNT --no-prompt", cwd = "paper", description = "Install the wordcount filter into paper/" }
formats = { depends-on = ["formats-paper", "formats-slides", "wordcount"], description = "Install every format at the tag pinned in pixi.toml" }
versions = { cmd = "echo pinned: $SSUS_PAPERS, $SSUS_SLIDES, $WORDCOUNT && cd paper && quarto list extensions && cd ../slides && quarto list extensions", description = "Show the pins and the installed formats" }

# The paper's copies, built from the same prose. Each copy is a Quarto
# profile with its own formats and output folder (paper/_quarto-*.yml), so
# no copy's render touches another's files; `render` builds them all.
tables = { cmd = "python analysis/tables/make_tables.py", description = "Run every table formatter in analysis/tables/" }
working = { cmd = "quarto render paper.qmd", cwd = "paper", depends-on = ["tables"], description = "The working paper, pdf and html, into paper/_output/working/" }
blind = { cmd = "quarto render paper.qmd --profile blind", cwd = "paper", depends-on = ["tables"], description = "The blinded manuscript, pdf and tex, into paper/_output/blind/" }
titlepage = { cmd = "quarto render title-page.qmd --profile titlepage", cwd = "paper", description = "The title page, pdf and tex, into paper/_output/titlepage/" }
render = { depends-on = ["working", "blind", "titlepage"], description = "Every copy of the paper, from the same prose" }
preview = { cmd = "quarto preview paper.qmd --to ssus-masthead-html", cwd = "paper", depends-on = ["tables"], description = "Preview the working-paper html, re-rendering on save" }

# A submission, frozen once in submissions/LABEL/: the upload bundle, the
# blind-hygiene checklist's result, and a snapshot of the paper's source.
submit = { cmd = "python -m ssus_papers.submit {{ label }} --paper paper", args = ["label"], depends-on = ["render"], description = "Render every copy, then freeze submissions/LABEL/" }
# Track changes from OLD (submissions/LABEL/source, a git ref, or a
# directory) to NEW (default: the working tree), rendered under the blind
# profile, so the copy is anonymous.
diff = { cmd = "qdiff {{ old }} {{ new }} --entry paper/paper.qmd --profile {{ profile }}", args = ["old", { arg = "new", default = "." }, { arg = "profile", default = "blind" }], depends-on = [{ task = "typst-diff", environment = "typst-diff" }], description = "Track-changes pdf from OLD to NEW, anonymous under the blind profile" }

# The talk.
slides = { cmd = "quarto render", cwd = "slides", description = "Render the deck" }
{%- endraw %}
